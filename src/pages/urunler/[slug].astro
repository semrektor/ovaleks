---
import Base from '../../layouts/Base.astro';
import ProductCard from '../../components/ProductCard.astro';
import { products, categories, img, md, plain, cleanDescription, productUrl, categoryUrl } from '../../lib/catalog.js';

export function getStaticPaths() {
  return products.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}

const { p } = Astro.props;
const cat = p.kategoriler.slice().sort((a, b) => b.yol.length - a.yol.length)[0];
const catFull = cat && categories.find((c) => c.slug === cat.slug);
const trail = catFull ? catFull.yol.split(' > ').map((ad, i, all) => categories.find((c) => c.yol === all.slice(0, i + 1).join(' > '))).filter(Boolean) : [];
const related = cat ? products.filter((x) => x.slug !== p.slug && x.kategoriler.some((k) => k.slug === cat.slug)).slice(0, 4) : [];
const net = p.alanlar?.Net || p.alanlar?.['Net Miktar'];
const facts = [
  ['Net miktar', net],
  ['Ambalaj', p.alanlar?.['Ambalaj Bilgisi']],
  ['Ürün kodu', p.sku],
  ['Menşe', p.alanlar?.['Menşe']],
  ['İşletme kayıt no', p.alanlar?.['İşletme Kayıt Numarası']],
].filter(([, v]) => v);
const summary = plain(cleanDescription(p)).slice(0, 155).replace(/\s+\S*$/, '');
const description = `Ovaleks ${p.ad}${net ? ` (${net})` : ''}. ${summary}…`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: p.ad,
  sku: p.sku || undefined,
  image: img(p) ? new URL(img(p), Astro.site).href : undefined,
  description: summary,
  brand: { '@type': 'Brand', name: 'Ovaleks' },
  category: cat?.yol,
};
---

<Base title={`${p.ad} | Ovaleks`} description={description} jsonLd={jsonLd}>
  <div class="wrap">
    <div class="page-head">
      <nav class="crumbs" aria-label="Sayfa yolu">
        <a href="/">Ana sayfa</a> / <a href="/urunler/">Ürünler</a>
        {trail.map((c) => <> / <a href={categoryUrl(c)}>{c.ad}</a></>)}
      </nav>
    </div>

    <div class="product">
      <div class="shot">{img(p) && <img src={img(p)} alt={p.gorsel_alt || p.ad} width="1000" height="1000" />}</div>
      <div class="info">
        <p class="eyebrow">{cat?.ad}</p>
        <h1 class="display">{p.ad}</h1>
        <dl>
          {facts.map(([k, v]) => <><dt>{k}</dt><dd>{v}</dd></>)}
        </dl>
        <div class="actions">
          <a class="btn" href="/#teklif">Toptan teklif al</a>
          <a class="btn ghost" href="tel:+902124239595">Hemen arayın</a>
        </div>
        <p class="kodeks">Türk Gıda Kodeksi’ne uygun olarak üretilmiştir.</p>
      </div>
    </div>

    <article class="prose" set:html={md(cleanDescription(p))} />

    {
      related.length > 0 && (
        <section class="related">
          <h2 class="display">Aynı gruptan</h2>
          <div class="grid">{related.map((x) => <ProductCard product={x} />)}</div>
        </section>
      )
    }
  </div>
</Base>

<style>
  .page-head { padding-bottom: 8px; }
  .product { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(24px, 5vw, 64px); align-items: center; }
  .shot { background: #fff; border: 1px solid var(--line); border-radius: 28px; overflow: hidden; }
  .info h1 { font-size: clamp(36px, 5vw, 68px); margin: 10px 0 22px; }
  dl { display: grid; grid-template-columns: max-content 1fr; gap: 10px 22px; margin: 0 0 26px; padding: 20px 0; border-block: 1px solid var(--line); }
  dt { color: var(--muted); font-size: 14px; }
  dd { margin: 0; font-weight: 600; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .kodeks { margin-top: 18px; font-size: 14px; color: var(--muted); }
  .prose { max-width: 760px; padding: 48px 0 24px; }
  .related { padding: 32px 0 80px; }
  .related h2 { font-size: 34px; margin-bottom: 20px; }
  @media (max-width: 820px) { .product { grid-template-columns: 1fr; } }
</style>
