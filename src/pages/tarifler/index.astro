---
import Base from '../../layouts/Base.astro';
import { recipes, plain } from '../../lib/catalog.js';

const list = recipes.slice().sort((a, b) => a.baslik.localeCompare(b.baslik, 'tr'));
---

<Base title="Tarifler ve Reçeteler | Ovaleks" description="Ovaleks ürünleriyle hazırlanan profesyonel reçeteler: kek miksleri, krem şanti, krema tozu, pandispanya ve daha fazlası.">
  <div class="wrap">
    <div class="page-head">
      <nav class="crumbs" aria-label="Sayfa yolu"><a href="/">Ana sayfa</a> / Tarifler</nav>
      <h1 class="display">Tarifler</h1>
    </div>
    <div class="grid recipes">
      {
        list.map((r) => (
          <a class="card" href={`/${r.slug}/`}>
            {r.gorsel_yerel && <img src={'/' + r.gorsel_yerel} alt={r.baslik} width="400" height="400" loading="lazy" decoding="async" />}
            <div class="body">
              <div class="name">{r.baslik}</div>
              <div class="meta">{plain(r.icerik_md).slice(0, 90).replace(/\s+\S*$/, '')}…</div>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</Base>

<style>
  .recipes { grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); padding-bottom: 80px; }
</style>
