---
// İhracat haritası: Türkiye'nin üzerindeki Ovaleks ambleminden oklar çıkar, satış yapılan ülkelere gider ve ülke adı belirir.
// Zemin (noktalı dünya haritası) ayrı dosyadır: public/gorseller/dunya-haritasi.svg  (scripts/dunya-haritasi.mjs üretir).
// İki düzen var:
//   geniş ekran: ülke adları amblemin çevresine yelpaze biçiminde dizilir (gerçek konumlarında değil, yönlerinde),
//   telefon:     harita Avrupa–Asya bölgesine yakınlaşır, oklar ülkelerin gerçek konumuna gider; adlar alttaki listede okunur.
const W = 1200, H = 650;
const M = [866, 231]; // amblemin merkezi (Türkiye'nin üzeri)

// Zemin haritasıyla aynı izdüşüm (scripts/dunya-haritasi.mjs)
const rad = Math.PI / 180, LON0 = -118, LON1 = 95, LAT_UST = 64;
const k = W / ((LON1 - LON0) * rad);
const mercY = (lat) => Math.log(Math.tan(Math.PI / 4 + (lat * rad) / 2));
const proj = (lon, lat) => [(lon - LON0) * rad * k, (mercY(LAT_UST) - mercY(lat)) * k];

// Geniş ekranda okların çıktığı noktalar: amblemin sol, sağ, üst ve alt kenarı
const cikis = { sol: [812, 231], sag: [920, 231], ust: [866, 217], alt: [866, 245] };

// [ülke, boylam, enlem, | geniş ekran: okun ucu x, y, metnin yanı, çıkış kenarı, (özel yol, son denetim noktası)]
// Dizilim kuralı: oklar amblemin yanındaki dar koridordan yükselip kendi satırında yana döner; adlar bu koridorun dışında durur.
const veri = [
  ['Polonya', 19.4, 52, 770, 63, 'sol', 'ust'],
  ['Almanya', 10.4, 51, 726, 84, 'sol', 'sol'],
  ['Romanya', 25, 46, 732, 105, 'sol', 'sol'],
  ['Bosna Hersek', 17.8, 44, 738, 126, 'sol', 'sol'],
  ['Sırbistan', 20.9, 44, 744, 147, 'sol', 'sol'],
  ['Bulgaristan', 25.3, 42.7, 750, 168, 'sol', 'sol'],
  ['Arnavutluk', 20, 41, 756, 189, 'sol', 'sol'],
  ['Yunanistan', 22, 39.5, 762, 210, 'sol', 'sol'],
  ['İspanya', -3.7, 40.4, 648, 231, 'sol', 'sol'],
  ['Fas', -6.8, 32, 632, 256, 'sol', 'sol'],
  ['Cezayir', 2.6, 30, 696, 280, 'sol', 'sol'],
  ['Tunus', 9.5, 34, 750, 304, 'sol', 'sol'],
  ['Libya', 17.5, 27.5, 786, 328, 'sol', 'sol'],
  ['Mısır', 30, 27, 846, 352, 'sol', 'alt'],
  // Uzak pazarlar: Meksika oku kuzeyden (Avrupa ve Atlantik üzerinden), Brezilya oku güneyden dolanır
  ['Meksika', -99.1, 19.4, 176, 350, 'sol', 'ust', 'M866,217 C872,70 800,22 640,22 C420,22 290,240 176,350', [290, 240]],
  ['Brezilya', -47.9, -15.8, 444, 540, 'sol', 'alt', 'M866,245 C872,330 884,430 800,484 C720,530 580,540 449,540'],
  ['Rusya', 37.6, 55.75, 914, 88, 'sag', 'ust'],
  ['Kazakistan', 67, 48, 1066, 111, 'sag', 'sag'],
  ['Kırgızistan', 74.6, 41.5, 1066, 135, 'sag', 'sag'],
  ['Özbekistan', 64, 41.5, 1066, 159, 'sag', 'sag'],
  ['Türkmenistan', 59.5, 39, 1066, 183, 'sag', 'sag'],
  ['Gürcistan', 43.4, 42.2, 974, 208, 'sag', 'sag'],
  ['Azerbaycan', 47.6, 40.3, 974, 231, 'sag', 'sag'],
  ['Irak', 44, 33, 958, 255, 'sag', 'sag'],
  ['İran', 53.7, 32.4, 990, 279, 'sag', 'sag'],
  ['Katar', 51.2, 25.3, 1006, 303, 'sag', 'sag'],
  ['BAE', 54.4, 24, 1022, 327, 'sag', 'sag'],
  ['Suudi Arabistan', 45, 24, 914, 351, 'sag', 'alt'],
];

// Geniş ekran: yelpaze düzeni
const genis = veri.map(([ad, , , x, y, yan, kenar, ozel, son]) => {
  const [sx, sy] = cikis[kenar];
  const s = yan === 'sol' ? 1 : -1; // metin soldaysa ok ucuna sağdan yaklaşır
  const c1 = [(sx + (x - sx) * 0.15).toFixed(1), (sy + (y - sy) * 0.8).toFixed(1)];
  const c2 = [(x + s * Math.max(Math.abs(x - sx) * 0.45, 26)).toFixed(1), y];
  // Ok ucunun açısı: özel yolda son denetim noktasından uca doğru, diğerlerinde yatay
  const aci = son ? (Math.atan2(y - son[1], x - son[0]) * 180) / Math.PI : s === 1 ? 180 : 0;
  return { ad, x, y, s, aci: aci.toFixed(1), yol: ozel || `M${sx},${sy}C${c1} ${c2} ${x + s * 5},${y}` };
});

// Telefon: harita x 540–1180, y 60–440 aralığına yakınlaşır. Oklar gerçek konumlara gider;
// kadrajın dışında kalan Meksika ve Brezilya için oklar sol kenara uzanır ve yalnızca bu ikisinin adı haritada yazar.
const KADRAJ = { x: 540, y: 60, w: 640, h: 380 };
const kenarHedef = { Meksika: [556, 176], Brezilya: [572, 418] };
const dar = veri.map(([ad, lon, lat]) => {
  const [x, y] = kenarHedef[ad] || proj(lon, lat);
  // Ok, amblemin kenarından (elips) başlar
  const a = Math.atan2(y - M[1], x - M[0]);
  const r = (62 * 20) / Math.hypot(20 * Math.cos(a), 62 * Math.sin(a));
  const sx = M[0] + Math.cos(a) * r, sy = M[1] + Math.sin(a) * r;
  // Hafif yukarı kavisli yay
  const dx = x - sx, dy = y - sy, uz = Math.hypot(dx, dy) || 1;
  let nx = dy / uz, ny = -dx / uz;
  if (ny > 0) { nx = -nx; ny = -ny; }
  const cx = (sx + x) / 2 + nx * uz * 0.2, cy = (sy + y) / 2 + ny * uz * 0.2;
  const f = (n) => n.toFixed(1);
  return { ad, x: f(x), y: f(y), kenar: ad in kenarHedef, aci: f((Math.atan2(y - cy, x - cx) * 180) / Math.PI), yol: `M${f(sx)},${f(sy)}Q${f(cx)},${f(cy)} ${f(x)},${f(y)}` };
});

// Haritanın altındaki liste: bölgelere göre
const bolgeler = [
  ['Balkanlar', 'Bulgaristan, Yunanistan, Romanya, Sırbistan, Bosna Hersek, Arnavutluk'],
  ['Avrupa', 'Almanya, Polonya, İspanya'],
  ['Kuzey Afrika', 'Fas, Cezayir, Tunus, Libya, Mısır'],
  ['Orta Doğu', 'Irak, Suudi Arabistan, Katar, BAE'],
  ['İran ve Kafkasya', 'İran, Azerbaycan, Gürcistan'],
  ['Rusya ve Orta Asya', 'Rusya, Kazakistan, Özbekistan, Türkmenistan, Kırgızistan'],
  ['Amerika', 'Meksika, Brezilya'],
];
---

<section class="ihracat" id="ihracat" data-ihracat>
  <div class="wrap">
    <p class="eyebrow">İhracat</p>
    <h2 class="display">İstanbul’da üretiyoruz, dört kıtaya gönderiyoruz.</h2>
    <p class="lead">Ovaleks ürünleri Kuzey Afrika’dan Orta Asya’ya, Balkanlar’dan Latin Amerika’ya uzanan pazarlarda profesyonel mutfaklara ulaşıyor.</p>

    <div class="harita" role="img" aria-label={`Ovaleks’in ihracat yaptığı ülkeler: ${veri.map((u) => u[0]).join(', ')}`} style={`--kx:${KADRAJ.x}; --ky:${KADRAJ.y}; --kw:${KADRAJ.w}; --kh:${KADRAJ.h}`}>
      <div class="ic">
        <img src="/gorseller/dunya-haritasi.svg" alt="" width={W} height={H} loading="lazy" decoding="async" />
        <svg viewBox={`0 0 ${W} ${H}`} aria-hidden="true">
          <!-- Geniş ekran: yelpaze -->
          <g class="genis" data-duzen="genis">
            {genis.map((u) => <path class="ok" d={u.yol} pathLength="1" data-ok />)}
            {
              genis.map((u) => (
                <g class="ulke" data-ulke>
                  <path class="uc" d="M0,0L-8,-3.6V3.6Z" transform={`translate(${u.x} ${u.y}) rotate(${u.aci})`} />
                  <text x={u.x - u.s * 8} y={u.y} text-anchor={u.s === 1 ? 'end' : 'start'} dominant-baseline="central">{u.ad}</text>
                </g>
              ))
            }
          </g>
          <!-- Telefon: gerçek konumlar -->
          <g class="dar" data-duzen="dar">
            {dar.map((u) => <path class="ok" d={u.yol} pathLength="1" data-ok />)}
            {
              dar.map((u) => (
                <g class="ulke" data-ulke>
                  {u.kenar ? (
                    <>
                      <path class="uc" d="M0,0L-13,-6V6Z" transform={`translate(${u.x} ${u.y}) rotate(${u.aci})`} />
                      <text x={Number(u.x) + 2} y={Number(u.y) - 20}>{u.ad}</text>
                    </>
                  ) : (
                    <circle cx={u.x} cy={u.y} r="6" />
                  )}
                </g>
              ))
            }
          </g>
          <g class="merkez" data-merkez>
            <circle class="hale" cx={M[0]} cy={M[1]} r="34" />
            <rect x={M[0] - 60} y={M[1] - 18} width="120" height="36" rx="18" />
            <image href="/gorseller/2020/08/ovaleks-logo-arkasi-beyaz.svg" x={M[0] - 50} y={M[1] - 11.5} width="100" height="23" />
          </g>
        </svg>
      </div>
    </div>

    <ul class="bolgeler">
      {bolgeler.map(([ad, liste]) => <li data-bolge><b>{ad}</b><span>{liste}</span></li>)}
    </ul>
  </div>
</section>

<style>
  .ihracat { padding: clamp(64px, 9vw, 120px) 0; background: #120907; overflow: hidden; }
  .ihracat h2 { font-size: clamp(34px, 5vw, 72px); margin: 10px 0 0; color: #fff; max-width: 20ch; }
  .ihracat .lead { font-size: clamp(17px, 1.6vw, 20px); max-width: 60ch; margin: 16px 0 0; color: #e6d8c6; }
  .harita { position: relative; margin: clamp(24px, 4vw, 48px) 0 0; }
  .ic { position: relative; }
  .ic img { display: block; width: 100%; height: auto; }
  .ic svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .dar { display: none; }
  .ok { fill: none; stroke: #ff7a81; stroke-width: 1.3; stroke-linecap: round; stroke-dasharray: 1; opacity: 0.85; }
  .uc, .ulke circle { fill: #ff7a81; }
  .ulke text { font-family: var(--text); font-size: 13.5px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; fill: #fff5e6; paint-order: stroke; stroke: #120907; stroke-width: 5px; stroke-linejoin: round; }
  .merkez rect { fill: #120907; stroke: var(--red); stroke-width: 1.5; }
  .merkez .hale { fill: none; stroke: var(--red); stroke-width: 1.5; opacity: 0; transform-box: fill-box; transform-origin: center; animation: hale 2.6s ease-out infinite; }
  @keyframes hale { 0% { opacity: 0.7; scale: 0.6; } 100% { opacity: 0; scale: 2.2; } }
  .bolgeler { list-style: none; margin: clamp(24px, 4vw, 44px) 0 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; }
  .bolgeler li { display: grid; align-content: start; gap: 4px; padding: 16px 18px; border: 1px solid #3a2a22; border-radius: 16px; background: #1c110d; }
  .bolgeler li:first-child { grid-column: span 2; }
  .bolgeler b { font-size: 13px; letter-spacing: 0.14em; text-transform: uppercase; color: #ff8a8f; }
  .bolgeler span { color: #e6d8c6; }
  @media (max-width: 1000px) {
    .bolgeler { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 760px) {
    /* Telefon: harita kenardan kenara uzanır ve Avrupa–Asya bölgesine yakınlaşır (kadraj: --kx --ky --kw --kh) */
    .genis { display: none; }
    .dar { display: block; }
    .harita { margin-inline: calc(var(--gutter) * -1); aspect-ratio: var(--kw) / var(--kh); overflow: hidden; }
    .ic { position: absolute; width: calc(1200 / var(--kw) * 100%); left: calc(var(--kx) / var(--kw) * -100%); top: calc(var(--ky) / var(--kh) * -100%); }
    .ok { stroke-width: 2.2; }
    .ulke circle { stroke: #120907; stroke-width: 2.5; }
    .ulke text { font-size: 21px; letter-spacing: 0.06em; stroke-width: 7px; }
    .bolgeler { gap: 10px; }
    .bolgeler li { padding: 12px 14px; }
    .bolgeler span { font-size: 14px; }
  }
  @media (prefers-reduced-motion: reduce) { .merkez .hale { animation: none; } }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);
  const el = document.querySelector('[data-ihracat]');
  if (el && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    // Harita görününce: amblem belirir, oklar sırayla çizilir, her okun ucunda ülke belirir; ardından bölge listesi gelir.
    // Yalnızca o ekranda görünen düzen (geniş ya da telefon) canlandırılır.
    const duzen = el.querySelector(window.matchMedia('(max-width: 760px)').matches ? '[data-duzen="dar"]' : '[data-duzen="genis"]');
    const oklar = gsap.utils.toArray('[data-ok]', duzen);
    const adlar = gsap.utils.toArray('[data-ulke]', duzen);
    const adim = 1.6 / oklar.length;
    const tl = gsap.timeline({ scrollTrigger: { trigger: el.querySelector('.harita'), start: 'top 72%', once: true } });
    tl.from(el.querySelector('[data-merkez]'), { autoAlpha: 0, duration: 0.5 })
      .fromTo(oklar, { strokeDashoffset: 1 }, { strokeDashoffset: 0, duration: 0.8, ease: 'power2.out', stagger: adim }, 0.3)
      .from(adlar, { autoAlpha: 0, duration: 0.3, stagger: adim }, 0.95)
      .from(gsap.utils.toArray('[data-bolge]', el), { autoAlpha: 0, y: 20, duration: 0.5, stagger: 0.06 }, 1.4);
  }
</script>
