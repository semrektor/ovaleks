---
// Numune ve toptan teklif formu (taslak: gönderim henüz bir yere bağlı değil). Ana sayfa ve Waffle Sosları sayfasında kullanılır.
import { site } from '../lib/catalog.js';
---

<section class="lead-section" id="teklif">
  <div class="wrap lead-grid">
    <div>
      <p class="eyebrow">Toptancı ve işletmeler için</p>
      <h2 class="display">Numune isteyin, teklif alın.</h2>
      <p class="lead">Bölgenizi ve ilgilendiğiniz aromaları yazın; satış ekibimiz sizi arasın.</p>
      <ul class="contact">
        <li><span>Telefon</span><a href={site.telefonHref}>{site.telefon}</a></li>
        <li><span>Satış</span><a href={`mailto:${site.eposta}`}>{site.eposta}</a></li>
        <li><span>Adres</span>{site.adres}</li>
      </ul>
    </div>
    <form class="lead-form" data-lead-form>
      <label>Firma adı<input name="firma" required autocomplete="organization" /></label>
      <label>Yetkili ad soyad<input name="yetkili" required autocomplete="name" /></label>
      <div class="row2">
        <label>Telefon<input name="telefon" type="tel" required autocomplete="tel" /></label>
        <label>İl / bölge<input name="il" required /></label>
      </div>
      <label>İşletme türü
        <select name="tur">
          <option>Toptancı / dağıtıcı</option>
          <option>Waffle işletmesi / kafe</option>
          <option>Pastane</option>
          <option>Otel / restoran / catering</option>
          <option>Diğer</option>
        </select>
      </label>
      <fieldset>
        <legend>Talep</legend>
        <label class="check"><input type="checkbox" name="talep" value="numune" /> Numune</label>
        <label class="check"><input type="checkbox" name="talep" value="teklif" checked /> Toptan fiyat teklifi</label>
        <label class="check"><input type="checkbox" name="talep" value="bayilik" /> Bölge bayiliği</label>
      </fieldset>
      <label>İlgilendiğiniz ürünler / notunuz<textarea name="not" rows="3"></textarea></label>
      <button class="btn" type="submit">Talebi gönder</button>
      <p class="form-note" data-form-note>Taslak: form henüz bir e-posta ya da müşteri takip sistemine bağlı değil.</p>
    </form>
  </div>
</section>


<style>
  .lead-section { position: relative; }
  h2.display { font-size: clamp(36px, 5.4vw, 80px); margin: 10px 0 0; }
  .lead { font-size: clamp(17px, 1.6vw, 20px); max-width: 52ch; }
  .lead-section { background: var(--red); color: #fff; padding: clamp(64px, 9vw, 120px) 0; }
  .lead-section .eyebrow { color: #ffd9db; }
  .lead-section .lead { color: #ffe9ea; }
  .lead-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(28px, 5vw, 72px); align-items: start; }
  .contact { list-style: none; padding: 0; margin: 28px 0 0; display: grid; gap: 14px; }
  .contact span { display: block; font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; color: #ffd9db; }
  .contact a { font-weight: 700; font-size: 20px; text-decoration: none; }
  .lead-form { background: #fff; color: var(--ink); border-radius: 24px; padding: clamp(20px, 3vw, 34px); display: grid; gap: 14px; }
  .lead-form label { display: grid; gap: 6px; font-size: 14px; font-weight: 600; }
  .lead-form input:not([type='checkbox']), .lead-form select, .lead-form textarea { font: inherit; font-weight: 400; padding: 12px 14px; border: 1px solid var(--line); border-radius: 12px; background: #fdfaf5; width: 100%; }
  .lead-form input:focus, .lead-form select:focus, .lead-form textarea:focus { outline: 2px solid var(--red); outline-offset: 1px; }
  .lead-form .row2 { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .lead-form fieldset { border: 0; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 8px 18px; }
  .lead-form legend { font-size: 14px; font-weight: 600; margin-bottom: 8px; padding: 0; }
  .lead-form .check { display: flex; align-items: center; gap: 8px; font-weight: 500; }
  .lead-form .btn { justify-content: center; }
  .form-note { font-size: 13px; color: var(--muted); margin: 0; }
  @media (max-width: 900px) { .lead-grid { grid-template-columns: 1fr; } }

</style>

<script>
// Taslak form: gönderim henüz bağlı değil
const form = document.querySelector('[data-lead-form]');
form?.addEventListener('submit', (e) => {
  e.preventDefault();
  const note = form.querySelector('[data-form-note]');
  if (note) note.textContent = 'Taslak sürüm: talep kaydedilmedi. Yayın öncesinde form satış e-postasına bağlanacak.';
});
</script>
