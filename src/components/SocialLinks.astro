---
// Sosyal medya ikonları. Tarif sayfasında tarifin bağlantıları (src/data/tarif-baglantilari.json),
// sitenin en altında firmanın hesapları (src/data/sosyal-baglantilar.json) gösterilir.
// Adresi henüz girilmemiş ikon soluk görünür ve tıklanmaz.
const { links = {}, label = 'Bu tarif sosyal medyada', aglar = ['instagram', 'youtube', 'linkedin', 'facebook'], koyu = false, tarif = false } = Astro.props;

const ikonlar = {
  instagram: ['Instagram', '<rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>'],
  youtube: ['YouTube', '<path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"/><polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"/>'],
  linkedin: ['LinkedIn', '<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/>'],
  facebook: ['Facebook', '<path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>'],
  whatsapp: ['WhatsApp', '<path class="dolu" d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>'],
};
const liste = aglar.map((key) => {
  const [ad, yol] = ikonlar[key];
  const url = String(links[key] || '').trim();
  return { key, ad, yol, url: /^https?:\/\//i.test(url) ? url : null };
});
const eksik = liste.some((a) => !a.url);
---

<div class:list={['social', { koyu }]}>
  {label && <span class="label">{label}</span>}
  <ul>
    {
      liste.map((a) => (
        <li>
          {a.url ? (
            <a class={a.key} href={a.url} target="_blank" rel="noopener" aria-label={tarif ? `Tarifi ${a.ad} üzerinde aç` : `Ovaleks ${a.ad}`} title={a.ad}>
              <svg viewBox="0 0 24 24" aria-hidden="true" set:html={a.yol} />
            </a>
          ) : (
            <span class={`${a.key} bos`} role="img" aria-label={`${a.ad} bağlantısı eklenecek`} title={`${a.ad} bağlantısı eklenecek`}>
              <svg viewBox="0 0 24 24" aria-hidden="true" set:html={a.yol} />
            </span>
          )}
        </li>
      ))
    }
  </ul>
  {eksik && <span class="taslak">bağlantılar eklenecek</span>}
</div>

<style>
  .social { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 16px; margin: 0 0 28px; --kenar: var(--line); --zemin: var(--paper); --renk: var(--ink); }
  .social.koyu { --kenar: #5a4237; --zemin: transparent; --renk: #f3e7d6; margin: 0; }
  .label { font-size: 13px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); }
  .koyu .label { color: #fff; }
  .social ul { list-style: none; display: flex; flex-wrap: wrap; gap: 10px; margin: 0; padding: 0; }
  .social a, .social span.bos { display: grid; place-items: center; width: 46px; height: 46px; border-radius: 50%; border: 1px solid var(--kenar); background: var(--zemin); color: var(--renk); transition: background 0.2s, color 0.2s, border-color 0.2s, transform 0.2s; }
  svg { width: 21px; height: 21px; fill: none; stroke: currentColor; stroke-width: 1.9; stroke-linecap: round; stroke-linejoin: round; }
  svg :global(.dolu) { fill: currentColor; stroke: none; }
  .social a:hover, .social a:focus-visible { color: #fff; border-color: transparent; transform: translateY(-2px); }
  a.instagram:hover, a.instagram:focus-visible { background: linear-gradient(45deg, #f9a03f, #e1306c 50%, #833ab4); }
  a.youtube:hover, a.youtube:focus-visible { background: #ff0000; }
  a.linkedin:hover, a.linkedin:focus-visible { background: #0a66c2; }
  a.facebook:hover, a.facebook:focus-visible { background: #1877f2; }
  a.whatsapp:hover, a.whatsapp:focus-visible { background: #128c4a; }
  .social span.bos { border-style: dashed; opacity: 0.45; cursor: default; }
</style>
